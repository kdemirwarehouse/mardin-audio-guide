# Copy to .env.local and fill in real values. NEVER commit real secrets.

# --- Database (Neon Postgres) — used from T3 ---
# Pooled connection string for the app
DATABASE_URL=""
# Direct (non-pooled) connection string for Prisma migrations
DIRECT_URL=""

# --- File storage (Vercel Blob) — used from T15 (TTS audio) ---
BLOB_READ_WRITE_TOKEN=""

# --- Auth (Auth.js + GitHub OAuth) — used from T11 ---
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=""

# --- AI: machine translation (T13) and text-to-speech (T15) ---
TRANSLATION_API_KEY=""
TTS_PROVIDER=""
TTS_API_KEY=""

# --- Public ---
# Canonical site URL, used in QR codes (e.g. https://mardin-audio-guide.vercel.app)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
